<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

  <BehaviorTree ID="MainTree">
    <Sequence name="startup_sequence">

      <!-- Your custom condition -->
      <ManagerRunning/>
      <ManagerDoneCondition/>
      <StartButtonCondition/>
      <StandUp/>
      <BallDetectedCondition/>
      <Parallel success_count="1" failure_count="1">

          <WalkToTarget/>

          <Timeout msec="10000">
              <AlwaysSuccess/>
          </Timeout>

      </Parallel>
      <LeftKick/>

    </Sequence>
  </BehaviorTree>

</root>